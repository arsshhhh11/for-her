*{box-sizing:border-box}html,body{margin:0;min-height:100%;font-family:"DM Sans",system-ui,sans-serif;color:#5b2345}body{overflow-x:hidden;background:#f7a9cf;min-height:100vh}body:before{content:"";position:fixed;inset:0;z-index:-6;background:radial-gradient(circle at 12% 8%,#fff 0 9%,transparent 25%),radial-gradient(circle at 85% 20%,#ffd8ea 0 10%,transparent 32%),radial-gradient(circle at 55% 95%,#e84f9b 0,transparent 36%),linear-gradient(135deg,#ffdff0,#f7a8cf 45%,#e55b9c)}body:after{content:"";position:fixed;inset:0;z-index:-5;opacity:.3;background-image:radial-gradient(#fff 1px,transparent 1px);background-size:18px 18px}.pink-noise{position:fixed;inset:0;z-index:-4;pointer-events:none;background:linear-gradient(115deg,transparent 0 38%,#fff4 45%,transparent 55%),repeating-linear-gradient(90deg,#fff0 0 16px,#fff1 17px 18px);mix-blend-mode:soft-light;animation:drift 16s linear infinite}@keyframes drift{50%{transform:translateX(-2%) translateY(1%)}100%{transform:none}}.y2k-orbit{position:fixed;font-family:Georgia,serif;color:#fff9;font-size:7rem;z-index:-2;filter:blur(.2px);animation:float 6s ease-in-out infinite}.o1{left:-15px;top:10%}.o2{right:-15px;bottom:14%;animation-delay:-2s}@keyframes float{50%{transform:translateY(-15px) rotate(8deg)}}.sticker{position:fixed;z-index:0;color:#ff4f9e;font-size:2rem;text-shadow:0 2px #fff;pointer-events:none}.star{top:5%;right:8%}.heart{bottom:6%;left:8%}.screen{display:none;min-height:100vh;padding:34px 16px;align-items:center;justify-content:center}.screen.active{display:flex;animation:enter .75s cubic-bezier(.2,.8,.2,1)}@keyframes enter{from{opacity:0;transform:translateY(18px) scale(.985)}to{opacity:1;transform:none}}.window-card{width:min(920px,100%);border:2px solid #fff8;border-radius:34px;background:linear-gradient(145deg,#fff9fdc9,#ffffff83);backdrop-filter:blur(22px) saturate(135%);-webkit-backdrop-filter:blur(22px) saturate(135%);box-shadow:0 30px 80px #8e1d5c45,inset 0 1px #fff,0 0 0 7px #ffffff26;overflow:hidden;position:relative}.window-card:before{content:"";position:absolute;inset:0;background:linear-gradient(125deg,#fff8 0 15%,transparent 32% 68%,#ff4fa811);pointer-events:none}.wide{width:min(1080px,100%)}.windowbar{height:48px;padding:0 18px;display:flex;align-items:center;gap:8px;background:#ffffff77;border-bottom:1px solid #fff9;position:relative;z-index:2}.traffic{width:12px;height:12px;border-radius:50%;box-shadow:inset 0 1px #fff8}.traffic.red{background:#ff6f93}.traffic.yellow{background:#ffd45f}.traffic.green{background:#68d99b}.window-title{margin:auto;font-size:.72rem;font-weight:700;letter-spacing:.06em;color:#9b4b75;text-transform:lowercase}.windowbody{padding:clamp(28px,5vw,62px);text-align:center;position:relative;z-index:1}.pixel-label{display:inline-block;color:#ef4e9a;font-size:.7rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;margin-bottom:15px}.pixel-label:before,.pixel-label:after{content:"♡";margin:0 7px;color:#ff5eaa}h1{font-family:"Playfair Display",Georgia,serif;line-height:1.04;font-size:clamp(2.2rem,6vw,5rem);margin:0 0 18px;color:#6d214f;text-shadow:0 2px #fff8}.sub,.windowbody>p{line-height:1.7;opacity:.75}.choice-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:25px}.glass-btn{border:1px solid #fff;background:#ffffff77;color:#7b2a59;border-radius:18px;padding:14px 23px;font-weight:800;box-shadow:0 12px 30px #8c1f5b22,inset 0 1px #fff;backdrop-filter:blur(14px);transition:.25s;cursor:pointer}.glass-btn:hover{transform:translateY(-3px) scale(1.01)}.glass-btn.hot{background:linear-gradient(135deg,#ff4d9e,#e72e83);color:white;border-color:#fff8;box-shadow:0 14px 30px #a6196348}.reply{min-height:28px;margin-top:18px;color:#d12c7b;font-weight:800}.cat-stage{width:min(310px,75vw);height:min(310px,75vw);margin:0 auto 22px;position:relative;display:grid;place-items:center}.cat-stage.small{width:min(280px,70vw);height:min(280px,70vw)}.blob{position:absolute;inset:4%;border-radius:45% 55% 50% 50%;background:linear-gradient(145deg,#fff,#ffd2e8 45%,#ff8ec4);box-shadow:inset 0 0 0 7px #fff7,0 25px 55px #9c1d6250}.cat-stage img{position:relative;max-width:100%;max-height:100%;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 18px 15px #7e185033)}.pin{max-width:760px}.pin input{width:min(320px,100%);padding:18px;text-align:center;font-size:2rem;letter-spacing:.3em;border-radius:20px;border:1px solid #fff;background:#ffffff99;outline:none;color:#7b2a59;box-shadow:inset 0 1px #fff,0 15px 35px #8b1c5a20}.error{min-height:25px;color:#cc2e74}.hero{padding-top:70px;padding-bottom:70px}.hero h1{max-width:900px;margin-left:auto;margin-right:auto}.hero p{max-width:780px;margin:0 auto 30px;font-size:1.08rem}.floating-sticker{position:absolute;right:9%;top:8%;font-size:3rem;color:#ff5aab;animation:float 5s ease-in-out infinite}.one-by-one{min-height:560px;display:grid;place-items:center;margin-top:20px}.reveal-wrap{width:min(390px,86vw);perspective:1400px}.reveal-card{position:relative;width:100%;aspect-ratio:.83;cursor:pointer;transform-style:preserve-3d;transition:transform 1s cubic-bezier(.2,.8,.2,1)}.reveal-card.open{transform:rotateY(180deg)}.reveal-front,.reveal-back{position:absolute;inset:0;backface-visibility:hidden;border-radius:28px;overflow:hidden;border:1px solid #fff;background:#ffffff65;box-shadow:0 25px 60px #86145230,inset 0 1px #fff}.reveal-front{display:grid;place-items:center;background:linear-gradient(145deg,#ffd5e9aa,#ff78b855);padding:24px}.reveal-front img{width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 20px 20px #9a1c5a30)}.tap-hint{position:absolute;bottom:20px;left:50%;transform:translateX(-50%);padding:9px 15px;border-radius:99px;background:#fff9;color:#c22978;font-weight:800;box-shadow:0 8px 22px #8c1e5b20}.reveal-back{transform:rotateY(180deg);padding:14px;display:flex;flex-direction:column}.portrait{height:68%;overflow:hidden;border-radius:21px;background:#fff}.portrait img{width:100%;height:100%;object-fit:cover;display:block}.note{flex:1;display:flex;flex-direction:column;justify-content:center;padding:10px 9px;position:relative}.note b{color:#cc327f;font-size:1rem;margin-bottom:6px}.note span{line-height:1.45;font-size:.85rem}.note i{position:absolute;right:4px;bottom:4px;color:#ef4e9a;font-style:normal}.progress{display:flex;justify-content:center;gap:8px;margin:5px 0 15px}.progress span{width:27px;height:27px;border-radius:50%;display:grid;place-items:center;background:#fff8;color:#b35a83;font-size:.72rem;font-weight:800}.progress span.on{background:#ef4e9a;color:#fff;box-shadow:0 0 0 4px #fff7}.next-btn{animation:enter .6s both}.cinema{display:flex;align-items:center;justify-content:center;gap:13px;margin:28px auto 12px}.cinema-frame{width:min(720px,76vw);aspect-ratio:16/10;border-radius:30px;overflow:hidden;position:relative;background:#fff;border:7px solid #fff9;box-shadow:0 30px 70px #7f14512f}.cinema-frame img{width:100%;height:100%;object-fit:cover;display:block;transition:.35s}.cinema-frame img.fade{opacity:.2;transform:scale(1.03)}.round-btn{width:48px;height:48px;border:1px solid #fff;background:#ffffff85;border-radius:50%;font-size:2rem;color:#a82b6c;box-shadow:0 10px 25px #8b1d5a22;cursor:pointer}.slide-count{position:absolute;right:14px;bottom:14px;padding:7px 12px;border-radius:99px;background:#5d1d4bb8;color:#fff;font-size:.75rem}.dots{display:flex;justify-content:center;gap:7px;margin:12px}.dot{width:8px;height:8px;border-radius:50%;background:#fff9;border:1px solid #e44793}.dot.active{background:#e44793;transform:scale(1.35)}.slide-caption{font-family:"Playfair Display",Georgia,serif;font-size:1.25rem;min-height:42px;color:#762250}.wish-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin:28px 0;text-align:left}.wish{min-height:132px;border:1px solid #fff;background:#ffffff72;border-radius:24px;padding:20px;text-align:left;color:#68264d;box-shadow:0 18px 35px #8d205c16,inset 0 1px #fff;cursor:pointer;position:relative;transition:.25s}.wish:hover{transform:translateY(-3px)}.wish b{display:block;color:#d52f80;margin-bottom:10px}.wish span{display:none;line-height:1.55}.wish.revealed span{display:block;animation:enter .35s ease}.wish i{position:absolute;right:16px;top:15px;color:#ed4c9b;font-style:normal}.birthday{min-height:650px}.cake-wrap{height:360px;position:relative;display:grid;place-items:end center;cursor:pointer}.cake{position:relative;width:300px;height:210px;z-index:2}.tier{position:absolute;left:7%;width:86%;border-radius:22px;box-shadow:inset 0 6px #fff9,0 15px 25px #82165026}.t1{height:72px;top:5px;background:linear-gradient(#fff0f8,#ffb5d4)}.t2{height:72px;top:62px;background:linear-gradient(#ffb2d2,#f47caf)}.t3{height:72px;top:119px;background:linear-gradient(#f07aaa,#df4f94)}.cream{position:absolute;top:60px;left:14%;width:72%;height:17px;border-radius:99px;background:#fff;box-shadow:0 6px 10px #9b1c5b22}.candle{position:absolute;top:-62px;width:18px;height:68px;border-radius:8px;background:repeating-linear-gradient(135deg,#fff 0 9px,#ef4b99 9px 15px);z-index:4}.candle:after{content:"";position:absolute;top:-17px;left:3px;width:12px;height:19px;border-radius:60% 40% 60% 40%;background:#ffbf69;box-shadow:0 0 17px #ffbf69}.c1{left:27%}.c2{left:48%}.c3{left:69%}.cake-cat{position:absolute;width:190px;height:190px;object-fit:contain;left:calc(50% - 300px);bottom:35px;z-index:3;filter:drop-shadow(0 20px 15px #7c145033);animation:float 3s ease-in-out infinite}.cake-wrap.blown .candle:after{display:none}.cake-wrap.blown .cake-cat{animation:celebrate .65s ease-in-out 3}@keyframes celebrate{50%{transform:translateY(-25px) rotate(7deg)}}.finale{position:relative;overflow:hidden;background:#05030a}.finale video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0}.finale-vignette{position:absolute;inset:0;background:linear-gradient(180deg,#05030a77,#05030a22 45%,#05030acc);z-index:1}.final-play{position:relative;z-index:3;width:90px;height:90px;border-radius:50%;border:1px solid #fff;background:#ffffff1f;color:#fff;font-size:2rem;backdrop-filter:blur(20px);box-shadow:0 15px 50px #0008;cursor:pointer}.spotify-glass{position:absolute;z-index:4;top:24px;left:50%;transform:translateX(-50%);width:min(640px,calc(100% - 28px));padding:12px 15px;border:1px solid #fff4;border-radius:24px;background:#10101799;backdrop-filter:blur(25px);display:flex;align-items:center;gap:13px;color:#fff;box-shadow:0 20px 60px #0008}.album-art{width:55px;height:55px;border-radius:14px;display:grid;place-items:center;background:linear-gradient(135deg,#ff5da8,#7b174c);font-size:1.6rem;box-shadow:inset 0 1px #fff5}.track-meta{flex:1;text-align:left}.track-meta b,.track-meta span{display:block}.track-meta span{font-size:.78rem;opacity:.65;margin-top:2px}.bar{height:3px;background:#ffffff35;border-radius:99px;margin-top:8px;overflow:hidden}.bar i{display:block;height:100%;width:0;background:#fff;border-radius:99px}.times{display:flex!important;justify-content:space-between;font-size:.65rem!important;opacity:.5!important;margin-top:3px}.play-small{width:40px;height:40px;border-radius:50%;border:1px solid #fff5;background:#fff;color:#191018;font-weight:800}.final-letter{position:relative;z-index:3;width:min(880px,calc(100% - 30px));max-height:78vh;overflow:auto;padding:34px 36px;margin-top:70px;border:1px solid #ffffff45;border-radius:30px;background:linear-gradient(145deg,#ffffff22,#ffffff0d);backdrop-filter:blur(32px) saturate(135%);-webkit-backdrop-filter:blur(32px) saturate(135%);color:#fff;box-shadow:0 30px 100px #0008,inset 0 1px #fff5;animation:glassIn 1.15s cubic-bezier(.2,.8,.2,1) both}.glass-shine{position:absolute;inset:-20% -20% auto;height:60%;background:linear-gradient(110deg,#fff4,transparent 45%);transform:rotate(-6deg);pointer-events:none}.final-letter h1{text-align:center;color:#fff;text-shadow:0 2px 18px #000}.final-letter .pixel-label{text-align:center;display:block}.final-letter p{line-height:1.8;color:#fffdfd;position:relative}.signature{text-align:center;font-size:1.1rem;margin-top:28px}.hidden{display:none!important}@keyframes glassIn{from{opacity:0;transform:translateY(40px) scale(.94);filter:blur(12px)}to{opacity:1;transform:none;filter:blur(0)}}@media(max-width:700px){.windowbody{padding:28px 20px}.wish-grid{grid-template-columns:1fr}.cinema-frame{width:78vw;aspect-ratio:4/5}.cinema .round-btn{width:40px;height:40px}.cake-cat{left:calc(50% - 185px);width:130px;height:130px}.cake{width:240px;height:185px}.final-letter{max-height:76vh;padding:28px 22px}.spotify-glass{top:12px}.final-play{width:78px;height:78px}.one-by-one{min-height:500px}}@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
