const interactive=[
['11.jpg','little Fia 🥹','before you were my girl, you were already this tiny little cutie… look at youuuu 😭🤏🏼'],
['12.png','that smile tho…','I swear your smile has no business making me this soft every single time. 🫠🤍'],
['13.png','my pretty girl','you could literally just exist and I’d still be here like… yeah, that’s my girl. 😭🫀'],
['14.jpg','kuchu puchu mode','this face??? yeah no. when we meet I’m absolutely squishing you. consider yourself warned. 🤏🏼🫂'],
['15.jpg','my favourite view','somehow you keep getting prettier and I keep falling harder. how is that even fair 😭🤍']
];
const slides=[['21.jpg','your eyes, your smile… everything about you feels like home 🤍'],['22.jpg','how am I supposed to act normal when you look like this 😭'],['23.jpg','my pretty girl, forever my favourite view 🫠🫀'],['24.jpg','that little smile is genuinely one of my favourite things in this world 🤏🏼'],['25.jpg','I’d still choose you in every version of every lifetime 🤍'],['26.jpg','and somehow you just keep getting more beautiful to me 🫂']];
const wishes=[
['♡ WISH #1','May we keep choosing each other, growing together, and making a thousand more memories. 🫂🤍'],
['♡ WISH #2','May you always know just how deeply loved, precious, special, and worthy you are. 🤍'],
['♡ WISH #3','May life be softer with you, and may the good days find you more often than the bad ones.'],
['♡ WISH #4','May every little dream you’ve been quietly keeping in your heart slowly find its way to you. ✨'],
['♡ WISH #5','May this be the year I finally get to squish my Kuchu Puchu in real life instead of doing it through a screen. 😭🤏🏼🫂'],
['♡ WISH #6','May you always be surrounded by the kind of love that makes you feel safe, adored, and never alone — the kind of love you deserve. 🫂🤍']
];
function show(id){document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));document.getElementById(id).classList.add('active');window.scrollTo({top:0,behavior:'smooth'});if(id==='sliderScreen')startSlider();}
function catNo(){show('noScreen')}
function catYes(){show('yesScreen')}
function catBackYes(){show('yesScreen')}
function toCat4(){show('cat4Screen')}
function checkPin(){let x=document.getElementById('pin');if(x.value.length===4){if(x.value==='2912'){show('heroScreen')}else{document.getElementById('pinError').textContent='hmm… our first little hello again 👀';x.value=''}}}
let current=0;
function renderInteractive(){const s=document.getElementById('interactiveStage');const p=interactive[current];s.innerHTML=`<div class="reveal-wrap"><div class="reveal-card ${current?'':'first'}"><div class="reveal-front"><img src="assets/Cat1.jpg"><div class="tap-hint">tap me ♡</div></div><div class="reveal-back"><div class="portrait"><img src="images/${p[0]}"></div><div class="note"><b>${p[1]}</b><span>${p[2]}</span><i>♡</i></div></div></div></div>`;document.getElementById('progress').innerHTML=interactive.map((_,i)=>`<span class="${i===current?'on':''}">${i+1}</span>`).join('');s.querySelector('.reveal-card').onclick=()=>{const card=s.querySelector('.reveal-card');if(!card.classList.contains('open')){card.classList.add('open');setTimeout(()=>{if(current<interactive.length-1){current++;renderInteractive()}else{const b=document.createElement('button');b.className='glass-btn hot next-btn';b.textContent='keep going, Kuchu Puchu →';b.onclick=()=>show('sliderScreen');s.appendChild(b)}},2100)}}}
function buildWishes(){const g=document.getElementById('wishGrid');g.innerHTML='';wishes.forEach(w=>{let b=document.createElement('button');b.className='wish';b.innerHTML=`<b>${w[0]}</b><span>${w[1]}</span><i>+</i>`;b.onclick=()=>b.classList.toggle('revealed');g.appendChild(b)})}
let slideIndex=0,timer;
function renderSlide(){const im=document.getElementById('slideImage');im.classList.add('fade');setTimeout(()=>{im.src='images/'+slides[slideIndex][0];im.classList.remove('fade')},180);document.getElementById('slideCount').textContent=`${slideIndex+1} / 6`;document.getElementById('sliderNote').textContent=slides[slideIndex][1];document.getElementById('slideDots').innerHTML=slides.map((_,i)=>`<span class="dot ${i===slideIndex?'active':''}"></span>`).join('')}
function slide(d){slideIndex=(slideIndex+d+slides.length)%slides.length;renderSlide()}
function startSlider(){clearInterval(timer);renderSlide();timer=setInterval(()=>slide(1),5200)}
function blowCandles(){document.querySelector('.cake-wrap').classList.add('blown');document.getElementById('cakeText').textContent='wish made… okay my girl, one last thing 🥹🤍';document.getElementById('letterButton').classList.remove('hidden')}
function startFinale(){show('letterScreen');document.getElementById('fireworks').pause();document.getElementById('fireworks').currentTime=0;document.getElementById('finalPlay').classList.remove('hidden')}
function playFinale(){const v=document.getElementById('fireworks');const a=document.getElementById('music');v.play().catch(()=>{});a.currentTime=0;a.play().catch(()=>{});document.getElementById('finalPlay').classList.add('hidden');document.getElementById('player').classList.remove('hidden');setTimeout(()=>document.getElementById('finalLetter').classList.remove('hidden'),1800);requestAnimationFrame(updateMusic)}
function toggleSong(){const a=document.getElementById('music'),b=document.getElementById('songBtn');if(a.paused){a.play();b.textContent='Ⅱ'}else{a.pause();b.textContent='▶︎'}}
function updateMusic(){const a=document.getElementById('music');if(!a.paused){let pct=a.duration?(a.currentTime/a.duration)*100:0;document.getElementById('seek').style.width=pct+'%';document.getElementById('elapsed').textContent=`${Math.floor(a.currentTime/60)}:${String(Math.floor(a.currentTime%60)).padStart(2,'0')}`;requestAnimationFrame(updateMusic)}}
document.querySelector('.cake-wrap').addEventListener('click',blowCandles);renderInteractive();buildWishes();renderSlide();
